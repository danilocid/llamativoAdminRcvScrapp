# Puerto del servicio (default: 3010)
PORT=3010

# Entorno (dev, prod)
ENV=dev

# ─── Autenticación ────────────────────────────────────────────────────────────
# Misma clave que usa el backend de Llamativo. Los JWT emitidos por
# POST /auth/login del backend son válidos para este servicio.
JWT_SECRET=TU_MISMO_SECRETO_QUE_EL_BACKEND

# ─── Conexión con el backend existente (quien tiene la base de datos) ─────────
# URL base del backend (sin barra final)
BACKEND_URL=http://localhost:3000
# Credenciales usadas para obtener el JWT via POST {BACKEND_URL}/auth/login
BACKEND_USER=tu_usuario_backend
BACKEND_PASSWORD=tu_password_backend

# (Opcional) Alternativa al JWT para llamadas servidor-a-servicio.
# Si está definida, los endpoints aceptan también el header: x-api-key: <valor>
# API_KEY=una_clave_larga_y_aleatoria

# (Opcional) Orígenes CORS separados por coma. Default: http://localhost:4200
# CORS_ORIGINS=http://localhost:4200,https://llamativo-admin.web.app

# ─── SII - Scraping del RCV (Playwright) ─────────────────────────────────────
SII_RUT=TU_RUT
SII_PASSWORD=TU_PASSWORD_SII

# (Opcional) Ruta al binario de Chromium/Chrome (Docker o Raspberry Pi)
# CHROME_BIN=/usr/bin/chromium
